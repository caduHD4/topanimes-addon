{
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/api/" },
    { "source": "/manifest.json", "destination": "/api/manifest.json" },
    { "source": "/catalog/:path*", "destination": "/api/catalog/:path*" },
    { "source": "/meta/:path*", "destination": "/api/meta/:path*" },
    { "source": "/stream/:path*", "destination": "/api/stream/:path*" },
    { "source": "/subtitles/:path*", "destination": "/api/subtitles/:path*" }
  ]
}
